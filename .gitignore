.DS_Store
__pycache__/
*.pyc
.ipynb_checkpoints/

# Data is downloaded/derived, never committed
# (exception: small external reference catalogs)
data/*
!data/external/

# Only final tables and results are tracked
outputs/*
!outputs/tables/
outputs/tables/*
!outputs/tables/final/
!outputs/tables/final_no_icme/
!outputs/results/
outputs/results/*
!outputs/results/final/
!outputs/results/final_no_icme/
